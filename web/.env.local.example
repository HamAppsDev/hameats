# PostHog analytics. Get a project API key from https://posthog.com.
# Without NEXT_PUBLIC_POSTHOG_KEY set, analytics is simply skipped.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Secret for /api/menu/status?key=..., which fetches the menus fresh. Without it the route always 404s.
STATUS_KEY=

# DynamoDB (favorites and the alert settings for logged-in people). Leave HAMEATS_DYNAMODB_TABLE empty for local test
# mode (web/lib/localMode.ts): `npm run dev` then keeps everything in memory and logs in as a made-up test student, no
# keys needed. The live site sets it to hameats-users; on AWS Lambda the function's role reaches the table, so no key is
# set there. Setup: infra/aws/README.md.
HAMEATS_AWS_REGION=us-east-2
HAMEATS_DYNAMODB_TABLE=
HAMEATS_AWS_ACCESS_KEY_ID=
HAMEATS_AWS_SECRET_ACCESS_KEY=

# Push notifications (web push "VAPID" keys): `npx web-push generate-vapid-keys`. Unset, the switch says they're off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Checked by /api/cron/alerts (at least 16 characters, e.g. `openssl rand -hex 24`). On AWS it's in Parameter Store.
CRON_SECRET=

# Log in with Google (Auth.js). AUTH_SECRET: any long random string (e.g. `npx auth secret`).
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: an OAuth client from console.cloud.google.com > APIs & Services > Credentials,
# with the authorized redirect URI https://www.hameats.app/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google for local dev).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: other schools' Google Workspace domains also allowed to log in, comma-separated (e.g. stanford.edu).
EXTRA_LOGIN_DOMAINS=

# Optional private test login: visiting /t/<this value> logs you in as test@hameats.app, with no Google. Make it long and
# random (`openssl rand -hex 24`) and keep it out of the repo. Unset, or under 24 characters, the link is switched off.
TEST_LOGIN_SECRET=
